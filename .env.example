# GastosE Environment Variables
# Copy this file to .env and fill in the values

# Database
POSTGRES_PASSWORD=change_this_in_production
# Used by alembic (Docker) — the app reads GASTOSE_DATABASE_URL
DATABASE_URL=postgresql+psycopg2://gastose:change_this_in_production@postgres:5432/gastose
GASTOSE_DATABASE_URL=postgresql+psycopg2://gastose:change_this_in_production@postgres:5432/gastose

# Security
GASTOSE_SECRET_KEY=change_this_to_a_random_secret_key

# Document storage
GASTOSE_DOCUMENT_STORAGE_PATH=./data/documents

# API
GASTOSE_API_HOST=0.0.0.0
GASTOSE_API_PORT=8000

# Logging
GASTOSE_LOG_LEVEL=INFO
